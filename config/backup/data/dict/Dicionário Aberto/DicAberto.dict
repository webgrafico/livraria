	Tira.
	(Cp. <i>ourela</i>)


oureça
	<b>oureça</b>
	<i>f. Prov. trasm.</i>
	O mesmo que <i>aragem</i>.
	(por <i>aureça</i>, de <i>aura</i>)


ouriceira
	<b>ouriceira</b>
	<i>f.</i>
