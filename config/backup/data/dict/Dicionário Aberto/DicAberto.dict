	(Do lat. <i>crudescere</i>)


encruecer
	<b>encruecer</b>
	<i>v. t.</i>
	Encruar.
	*
	Encarniçar, tornar feroz. Cf. Filinto, <i>D. Man.</i>, I, 136.
	* <i>V. i.</i>
	Tornar-se feroz, sanguinolento. Cf. <i>Lusíadas</i>, IV, 42.
	(De <i>cru</i>)


encruelecer
	<b>encruelecer</b>
	<i>v. i.</i> e <i>p.</i>
	(V. <i>encrudelecer</i>)


encrustar
	<b>encrustar</b>
	<i>v. t.</i>
