	(De <i>sidéreo</i>)
	
	<b>sidérico,<sup>2</sup></b>
	<i>adj.</i>
	Relativo ao ferro.
	(Do gr. <i>sideros</i>)


sidónio
	<b>sidónio</b>
	<i>adj.</i>
