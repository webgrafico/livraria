abarbarado
	<b>abarbarado</b>
	<i>adj. Bras.</i>
	Temerário.
	Valente.
	Terrivel.
	(De <i>bárbaro</i>).


abarbarizar
	<b>abarbarizar</b>
	<i>v. t.</i>
	(V. <i>barbarizar</i>).


abarbear
	<b>abarbear</b>
	<i>v. t.</i>
