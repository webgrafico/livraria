monoceronte
	<b>monoceronte</b>
	<i>m.</i>
	O mesmo que <i>unicórneo</i>.
	(Do gr. <i>monos</i> + <i>keras</i>)


monochiro
	<b>monochiro, (_qui_)</b>
	<i>m.</i>
	Gênero de peixes chatos.
	(Do gr. <i>monos</i> + <i>kheir</i>)


monochlamýdeas
	<b>monochlamýdeas</b>
	<i>f. pl.</i>
