alfarricoque
	<b>alfarricoque</b>
	<i>m. Ant.</i>
	Homem de pequena estatura.
	(Cp. <i>farricoco</i>)


alfarroba
	<b>alfarroba, (_rô_)</b>
	<i>f.</i>
	Fruto da alfarrobeira.
	(Do ár. <i>al-carroba</i>)


alfarrobado
	<b>alfarrobado</b>
	<i>adj.</i>
