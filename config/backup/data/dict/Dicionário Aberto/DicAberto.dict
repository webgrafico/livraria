siderografia
	<b>siderografia</b>
	<i>f.</i>
	Arte de gravar em aço.
	(Do gr. <i>sideros</i> + <i>graphein</i>)


siderographia
	<b>siderographia</b>
	<i>f.</i>
	Arte de gravar em aço.
	(Do gr. <i>sideros</i> + <i>graphein</i>)


siderográfico
	<b>siderográfico</b>
	<i>adj.</i>
