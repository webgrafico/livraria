	(Lat. <i>deprimens</i>)


deprimir
	<b>deprimir</b>
	<i>v. t.</i>
	Abaixar, abater.
	Aviltar.
	Humilhar.
	(Lat. <i>deprimere</i>)


depurador
	<b>depurador</b>
	<i>adj.</i>
	Que depura.
	<i>m.</i>
