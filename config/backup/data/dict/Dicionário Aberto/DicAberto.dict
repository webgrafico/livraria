	(Do gr. <i>ophis</i> + <i>odous</i>)


ophioglossita
	<b>ophioglossita</b>
	<i>f.</i>
	Língua de serpente, fossilizada.
	(Do gr. <i>ophis</i> + <i>glossa</i>)


ophioglosso
	<b>ophioglosso</b>
	<i>m.</i>
	Gênero de fêtos.
	(Do gr. <i>ophis</i> + <i>glossa</i>)


ophioglossáceos
	<b>ophioglossáceos</b>
	<i>m. pl.</i>
