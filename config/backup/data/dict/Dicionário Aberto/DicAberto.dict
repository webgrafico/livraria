acalantho
	<b>acalantho</b>
	<i>m.</i>
	Nôme scientífico do tentilhão.
	(Gr. <i>akalanthos</i>)


acalanto
	<b>acalanto</b>
	<i>m.</i>
	Nôme scientífico do tentilhão.
	(Gr. <i>akalanthos</i>)


acalar
	<b>acalar</b>
