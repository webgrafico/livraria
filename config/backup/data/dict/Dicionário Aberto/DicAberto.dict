	(Do lat. <i>tergiversator</i>)


tergiversante
	<b>tergiversante</b>
	<i>adj.</i>
	Que tergiversa.
	(Lat. <i>tergiversans</i>)


tergiversar
	<b>tergiversar</b>
	<i>v. i.</i>
